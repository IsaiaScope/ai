{
  "_comment": "Copy to ~/.config/hetzner/fleet.json and edit. Schema: see README.md. No secrets belong in this file.",

  "default": "main",

  "defaults": {
    "type": "cax11",
    "image": "ubuntu-24.04",
    "location": "fsn1",
    "port": 2222,
    "user": "isoonfire",
    "key": "~/.ssh/id_ed25519_hetzner",
    "key_fingerprint_prefix": "REPLACE-ME",
    "firewall": "vps-firewall",
    "hcloud_context": "vps",
    "protected": false
  },

  "servers": {
    "main": {
      "ssh_alias": "main-vps",
      "expect_hostname": "main",
      "ip": "203.0.113.10",
      "user": "main-user",
      "protected": true,
      "hcloud_server": "main",
      "hcloud_id": "000000000",
      "notes": "Pre-existing box: overrides defaults.user. Everything else inherited."
    },

    "staging": {
      "ssh_alias": "staging-vps",
      "expect_hostname": "staging",
      "ip": "203.0.113.42",
      "protected": false,
      "hcloud_server": "staging",
      "hcloud_id": "000000001",
      "notes": "Built by hetzner-create — inherits every default, so the entry stays lean."
    }
  }
}
